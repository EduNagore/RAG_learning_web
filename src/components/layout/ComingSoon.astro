---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { url } from '../../lib/url';

interface Props {
  title: string;
  description: string;
  phase: string;
}
const { title, description, phase } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="mx-auto max-w-2xl py-12 text-center">
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">{description}</p>
    <p class="mt-6 inline-block rounded-full bg-amber-100 px-3 py-1 text-sm font-medium text-amber-900 dark:bg-amber-950 dark:text-amber-200">
      En construcción · se completa en {phase}
    </p>
    <p class="mt-8">
      <a
        href={url('/teoria/')}
        class="font-medium text-indigo-700 hover:underline dark:text-indigo-300"
      >
        Mientras tanto, empieza por la teoría →
      </a>
    </p>
  </div>
</BaseLayout>
