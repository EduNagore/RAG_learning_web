---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const items = Astro.props.headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{items.length > 0 && (
  <nav aria-label="En esta página" class="text-sm">
    <h2 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-500 dark:text-slate-400">
      En esta página
    </h2>
    <ul class="space-y-1 border-l border-slate-200 dark:border-slate-800">
      {items.map((h) => (
        <li>
          <a
            href={`#${h.slug}`}
            class:list={[
              'block py-0.5 text-slate-600 hover:text-indigo-700 dark:text-slate-400 dark:hover:text-indigo-300',
              h.depth === 3 ? 'pl-6' : 'pl-3',
            ]}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
