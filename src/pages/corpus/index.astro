---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { ACCESS_LABELS, KIND_LABELS, corpus, docHref, golden } from '../../lib/corpus';
import { url } from '../../lib/url';

const sorted = [...corpus].sort((a, b) => a.id.localeCompare(b.id));
const title = new Map(corpus.map((d) => [d.id, d.title]));
const link = 'text-indigo-700 underline underline-offset-2 dark:text-indigo-300';
---

<BaseLayout
  title="Corpus de ejemplo"
  description="Los documentos ficticios de Nimbus Logística que usan las lecciones y los laboratorios (doc-001...), con sus metadatos y las preguntas de evaluación."
>
  <Breadcrumbs items={[{ label: 'Corpus de ejemplo' }]} />
  <h1 class="text-3xl font-bold tracking-tight">Corpus de ejemplo</h1>
  <p class="mt-2 max-w-3xl text-slate-600 dark:text-slate-400">
    Las lecciones y los laboratorios se apoyan en un corpus ficticio de {corpus.length} documentos
    de
    <strong>Nimbus Logística</strong>, una empresa inventada. Aquí puedes leerlos con sus metadatos
    (departamento, tipo, fecha y nivel de acceso) y ver las {golden.length} preguntas del conjunto
    de evaluación. Todo el contenido es inventado para el curso.
  </p>

  <h2 class="mt-8 text-xl font-semibold" id="documentos">
    Documentos
  </h2>
  <div class="mt-3 overflow-x-auto">
    <table class="w-full border-collapse text-sm">
      <caption class="sr-only">Documentos del corpus de ejemplo</caption>
      <thead>
        <tr class="border-b border-slate-300 text-left dark:border-slate-700">
          <th scope="col" class="p-2">
            Id
          </th>
          <th scope="col" class="p-2">
            Título
          </th>
          <th scope="col" class="p-2">
            Departamento
          </th>
          <th scope="col" class="p-2">
            Tipo
          </th>
          <th scope="col" class="p-2">
            Acceso
          </th>
          <th scope="col" class="p-2">
            Actualizado
          </th>
        </tr>
      </thead>
      <tbody>
        {sorted.map((d) => (
          <tr class="border-b border-slate-100 dark:border-slate-800" data-testid="corpus-row">
            <th scope="row" class="p-2 text-left font-mono font-medium">
              <a class={link} href={docHref(d.id)}>
                {d.id}
              </a>
            </th>
            <td class="p-2">{d.title}</td>
            <td class="p-2">{d.department}</td>
            <td class="p-2">{KIND_LABELS[d.kind]}</td>
            <td class="p-2">{ACCESS_LABELS[d.access]}</td>
            <td class="p-2 tabular-nums">{d.updated}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 class="mt-10 text-xl font-semibold" id="preguntas">
    Preguntas del conjunto de evaluación
  </h2>
  <p class="mt-1 max-w-3xl text-sm text-slate-600 dark:text-slate-400">
    Cada pregunta indica los documentos que contienen la respuesta, si se puede responder con el
    corpus y el nivel de acceso que exige. Las que no se pueden responder sirven para practicar la
    abstención.
  </p>
  <ul class="mt-3 space-y-3">
    {golden.map((q) => (
      <li id={q.id} class="rounded-lg border border-slate-200 p-3 text-sm dark:border-slate-800">
        <p class="font-medium">
          <span class="font-mono">{q.id}</span> · {q.question}
        </p>
        <p class="mt-1 text-slate-600 dark:text-slate-400">
          {q.answerable
            ? `Respuesta de referencia: ${q.reference_answer}`
            : 'Sin respuesta en el corpus: lo correcto es abstenerse.'}
        </p>
        <p class="mt-1 text-xs text-slate-600 dark:text-slate-400">
          Acceso requerido: {ACCESS_LABELS[q.requires_access]}
          {q.relevant_ids.length > 0 && (
            <>
              {' · Documentos: '}
              {q.relevant_ids.map((id, i) => (
                <>
                  {i > 0 && ', '}
                  <a class="underline underline-offset-2" href={docHref(id)} title={title.get(id)}>
                    {id}
                  </a>
                </>
              ))}
            </>
          )}
        </p>
      </li>
    ))}
  </ul>

  <p class="mt-8 text-sm">
    <a class={link} href={url('/practica/labs/')}>
      Practicar con estos documentos en los laboratorios →
    </a>
  </p>
</BaseLayout>
