---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Página no encontrada">
  <div class="mx-auto max-w-xl py-16 text-center">
    <h1 class="text-4xl font-bold">404</h1>
    <p class="mt-3 text-lg text-slate-600 dark:text-slate-400">
      Esta página no existe o se ha movido.
    </p>
    <p class="mt-6">
      <a href={url('/')} class="font-medium text-indigo-700 hover:underline dark:text-indigo-300">
        Volver al inicio
      </a>
    </p>
  </div>
</BaseLayout>
