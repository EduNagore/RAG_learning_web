---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Callout from '../../../components/content/Callout.astro';
import Diagram from '../../../components/content/Diagram.astro';
import KeyTakeaways from '../../../components/content/KeyTakeaways.astro';
import Snapshot from '../../../components/content/Snapshot.astro';
import { getCases } from '../../../lib/interview';
import { url } from '../../../lib/url';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCases();
  return cases.map((c) => ({ params: { id: c.id }, props: { entry: c } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const lessons = await getCollection('lessons');
const related = entry.data.lessons.flatMap((id) => {
  const l = lessons.find((x) => x.id === id);
  return l ? [{ id, title: l.data.title }] : [];
});
const reviewed = entry.data.lastReviewed.toISOString().slice(0, 10);
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <nav aria-label="Migas de pan" class="text-sm text-slate-500">
    <a class="hover:underline" href={url('/entrevistas/')}>
      Entrevistas
    </a>{' '}
    › System design
  </nav>
  <article data-pagefind-body class="prose prose-slate mt-3 max-w-3xl dark:prose-invert">
    <h1>{entry.data.title}</h1>
    <p class="lead">{entry.data.description}</p>
    <p class="text-sm text-slate-500">
      Nivel {entry.data.level} · {entry.data.estimatedMinutes} min · Revisado el {reviewed}
    </p>
    <Content components={{ Callout, Diagram, KeyTakeaways, Snapshot }} />
    {related.length > 0 && (
      <>
        <h2>Lecciones relacionadas</h2>
        <ul>
          {related.map((l) => (
            <li>
              <a href={url(`/teoria/${l.id}/`)}>{l.title}</a>
            </li>
          ))}
        </ul>
      </>
    )}
  </article>
</BaseLayout>
