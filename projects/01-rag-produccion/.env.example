# Copia este archivo a .env y rellénalo. NUNCA subas .env al repositorio.
ANTHROPIC_API_KEY=
# Identificador del modelo de generación (consulta los modelos vigentes en la documentación del proveedor)
MODEL=claude-sonnet-5-5
# Qdrant local en memoria o servidor: ":memory:" o "http://localhost:6333"
QDRANT_URL=:memory:
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
